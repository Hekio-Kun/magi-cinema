# ==============================================================================
# DATABASE CONFIGURATION (POSTGRESQL)
# ==============================================================================
# Lựa chọn 1: Chạy Local / Docker
DB_URL=jdbc:postgresql://localhost:5433/movietheater
DB_USER=postgres
DB_PASSWORD=root

# Lựa chọn 2: Dùng Neon Cloud PostgreSQL (Bỏ comment 3 dòng dưới và comment 3 dòng trên)
# DB_URL=jdbc:postgresql://<neon-host>:5432/<database-name>?sslmode=require
# DB_USER=<neon-username>
# DB_PASSWORD=<neon-password>

# ==============================================================================
# SECURITY & JWT CONFIGURATION
# ==============================================================================
# Khóa bí mật ký JWT (chuỗi base64 tối thiểu 256-bit)
JWT_SIGNER_KEY=your_jwt_secret_key_base64_here
# Bật kiểm tra độ an toàn của khóa (khuyến nghị để false ở dev/demo)
APP_REQUIRE_SAFE_SECRETS=false

# ==============================================================================
# MAIL SERVICE (GMAIL SMTP)
# ==============================================================================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
# Khuyên dùng khi deploy lên Render/Cloud (gửi qua HTTPS port 443 không bao giờ bị chặn)
BREVO_API_KEY=your_brevo_api_key_here

# ==============================================================================
# INITIAL ADMIN SETUP (Tự động khởi tạo tài khoản Admin khi chạy lần đầu)
# ==============================================================================
ADMIN_SETUP_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ==============================================================================
# CLOUDINARY (Lưu trữ hình ảnh poster phim, avatar, combo và audio)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_AUDIO_FOLDER=magi-cinema/audio

# Optional multipart limits for Cloudinary Audio Lab
MULTIPART_MAX_FILE_SIZE=50MB
MULTIPART_MAX_REQUEST_SIZE=55MB

# ==============================================================================
# ZALOPAY PAYMENT GATEWAY
# ==============================================================================
ZALOPAY_APP_ID=2554
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_CREATE_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_REDIRECT_URL=http://localhost:3000/payment/zalopay/return
ZALOPAY_CALLBACK_URL=
ZALOPAY_FRONTEND_PAYMENT_URL=http://localhost:3000/payment/zalopay
ZALOPAY_ORDER_EXPIRE_SECONDS=900

# ==============================================================================
# MOMO PAYMENT GATEWAY
# ==============================================================================
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_CREATE_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/payment/momo/return
# Khi deploy lên cloud (Render/VPS), đổi localhost:8080 thành URL domain backend public
MOMO_IPN_URL=http://localhost:8080/payment/momo/ipn
MOMO_REQUEST_TYPE=payWithMethod
MOMO_LANG=vi
MOMO_LOCAL_MOCK_ENABLED=false

# ==============================================================================
# FRONTEND & CORS CONFIGURATION
# ==============================================================================
# Khi deploy lên Vercel/Cloud, thay thế URL localhost bằng domain frontend của bạn
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# THIRD-PARTY INTEGRATIONS
# ==============================================================================
# TMDB API (Tra cứu thông tin phim)
TMDB_API_KEY=your_tmdb_api_key

# Google Sheets API (Import danh sách nhân viên từ Google Form)
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key
STAFF_IMPORT_SPREADSHEET_ID=your_spreadsheet_id
STAFF_IMPORT_RANGE=Câu trả lời biểu mẫu 1!A:K

# Google Gemini AI API (Gợi ý phim / Chatbot hỗ trợ)
GEMINI_API_KEY=your_gemini_api_key
