# URL gốc của backend, không thêm dấu "/" ở cuối.
# Khi thử QR bằng điện thoại, dùng IP LAN của máy tính, ví dụ http://192.168.1.10:8080.
VITE_API_URL=http://localhost:8080

# Dự phòng khi backend chưa kết nối được; landing page sẽ ưu tiên GET /public/audio.
# Có thể dùng JSON hoặc mỗi bài một dòng theo định dạng: Tên bài|Nghệ sĩ|URL audio.
VITE_PUBLIC_AUDIO_TRACKS=[{"title":"Magi Cinema Playlist 01","artist":"Magi Cinema","url":"https://res.cloudinary.com/dq0jm9tlt/video/upload/v1789376573/magi-cinema/audio/c0a7108b-1b6d-4c00-bf1b-b4bc97497f4d.mp3"},{"title":"Magi Cinema Playlist 02","artist":"Magi Cinema","url":"https://res.cloudinary.com/dq0jm9tlt/video/upload/v1789376280/magi-cinema/audio/ee5fce82-aa13-440b-9b7f-e4bcc7c85bf9.mp3"}]
